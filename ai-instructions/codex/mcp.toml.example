[mcp_servers.zotero]
command = "/absolute/path/to/zotero-mcp"
enabled_tools = [
    "zotero_semantic_search",
    "zotero_search_items",
    "zotero_search_by_tag",
    "zotero_search_by_citation_key",
    "zotero_advanced_search",
    "zotero_search_collections",
    "zotero_get_collections",
    "zotero_get_collection_items",
    "zotero_get_item_metadata",
    "zotero_get_item_fulltext",
    "zotero_get_item_children",
    "zotero_get_item_related",
    "zotero_get_attachment_path",
    "zotero_read_pdf_pages",
    "zotero_get_pdf_outline",
    "zotero_get_annotations",
    "zotero_get_notes",
    "zotero_get_tags",
    "zotero_get_recent",
    "zotero_library_coverage",
    "zotero_list_libraries",
    "zotero_get_search_database_status",
]

[mcp_servers.zotero.env]
ZOTERO_LOCAL = "true"

[mcp_servers.zotero.tools.zotero_list_libraries]
approval_mode = "approve"

[mcp_servers.zotero.tools.zotero_get_search_database_status]
approval_mode = "approve"

[mcp_servers.zotero.tools.zotero_semantic_search]
approval_mode = "approve"

[mcp_servers.zotero.tools.zotero_read_pdf_pages]
approval_mode = "approve"

[mcp_servers.zotero.tools.zotero_get_item_metadata]
approval_mode = "approve"
